### 🎯 Seçenek 1: Kendi YouTube URL'nizi kullanın
Aşağıdaki hücreyi çalıştırın ve `your_youtube_url` kısmını kendi URL'nizle değiştirin:# 🔧 Ana fonksiyonlar

def download_subs(youtube_url: str, lang: str = "en", use_cookies: bool = False) -> bool:
    """
    YouTube'dan altyazı indir
    
    Args:
        youtube_url: YouTube video URL'si
        lang: Dil kodu (varsayılan: "en")
        use_cookies: Browser cookies kullan (varsayılan: False)
    
    Returns:
        bool: İndirme başarılı ise True
    """
    # Eski VTT dosyalarını temizle
    for f in glob.glob("*.vtt"):
        os.remove(f)
    
    print("🔽 Altyazı indiriliyor...")
    
    ydl_opts = {
        "writesubtitles": True,
        "writeautomaticsub": True,
        "subtitleslangs": [lang],
        "skip_download": True,
        "outtmpl": "%(title)s.%(ext)s",
        "quiet": True,
        "no_warnings": True,
        # Bot korumasına karşı user agent
        "http_headers": {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'
        }
    }
    
    # Cookies kullan (eğer istenirse)
    if use_cookies:
        ydl_opts["cookiesfrombrowser"] = ("chrome",)
    
    try:
        with YoutubeDL(ydl_opts) as ydl:
            ydl.download([youtube_url])
        return True
    except Exception as e:
        error_msg = str(e)
        if "Sign in to confirm" in error_msg or "bot" in error_msg:
            print("⚠️  YouTube bot koruması aktif!")
            print("💡 Çözüm önerileri:")
            print("   • Daha popüler/eski bir video deneyin")
            print("   • use_cookies=True parametresi deneyin")
            print("   • Farklı bir IP adresinden deneyin")
        else:
            print(f"❌ Altyazı indirme hatası: {error_msg}")
        return False


def clean_transcript_with_timestamps(vtt_file: str = None) -> Optional[str]:
    """
    VTT dosyasını temizleyip zamanlı transkript oluştur
    
    Args:
        vtt_file: VTT dosya yolu (None ise mevcut dizini arar)
    
    Returns:
        str: Temizlenmiş transkript metni
    """
    if vtt_file:
        vtt_files = [vtt_file] if os.path.exists(vtt_file) else []
    else:
        vtt_files = glob.glob("*.vtt")
    
    if not vtt_files:
        print("❌ VTT dosyası bulunamadı.")
        return None

    file = vtt_files[0]
    print(f"✅ VTT dosyası bulundu: {file}")

    transcript = []
    last_entry = ""
    current_time = ""

    try:
        with open(file, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()

                # WEBVTT başlığını atla
                if line.startswith("WEBVTT"):
                    continue

                # Zaman damgasını çıkar
                if "-->" in line:
                    current_time = line.replace(".", ",")  # Daha uyumlu zaman formatı
                    continue

                # Boş satırları ve sayıları atla
                if not line or line.isdigit():
                    continue

                # HTML etiketlerini temizle ve entities'leri decode et
                text = re.sub(r"<.*?>", "", line)
                text = html.unescape(text)
                text = re.sub(r"^>>\s*", "", text)  # Konuşmacı göstergelerini kaldır

                # Zamanlı girişi ekle
                if current_time and text:
                    entry = f"[{current_time}] {text}"
                    if entry != last_entry:  # Tekrarları önle
                        transcript.append(entry)
                        last_entry = entry
                    current_time = ""

        # Dosyaya kaydet
        output_file = "timestamped_transcript.txt"
        with open(output_file, "w", encoding="utf-8") as out:
            out.write("\n".join(transcript))

        print(f"💾 '{output_file}' dosyasına kaydedildi.")
        return "\n".join(transcript)
    
    except Exception as e:
        print(f"❌ Transkript işleme hatası: {e}")
        return None


def generate_transcript_with_time(youtube_url: str, lang: str = "en", use_cookies: bool = False, show_preview: bool = True) -> Optional[str]:
    """
    Tam süreç: YouTube'dan altyazı indir ve zamanlı transkript oluştur
    
    Args:
        youtube_url: YouTube video URL'si
        lang: Dil kodu (varsayılan: "en")
        use_cookies: Browser cookies kullan (varsayılan: False)
        show_preview: Önizleme göster (varsayılan: True)
    
    Returns:
        str: Temizlenmiş transkript metni
    """
    print(f"🎬 Video URL: {youtube_url}")
    print(f"🌐 Dil: {lang}")
    print("-" * 80)
    
    # Altyazıyı indir
    if not download_subs(youtube_url, lang, use_cookies):
        return None
    
    # Transkripti işle
    result = clean_transcript_with_timestamps()
    
    if result:
        print("\n🕒 Transkript başarıyla oluşturuldu!")
        print(f"📊 Toplam karakter sayısı: {len(result):,}")
        print(f"📏 Toplam satır sayısı: {len(result.splitlines()):,}")
        print("📁 Tam transkript 'timestamped_transcript.txt' dosyasında.")
        
        if show_preview:
            print("\n📖 Transkript Önizlemesi (İlk 1000 karakter):")
            print("-" * 50)
            preview = result[:1000] + "..." if len(result) > 1000 else result
            print(preview)
        
        return result
    else:
        print("❌ Transkript oluşturulamadı.")
        return None


def test_with_sample_videos():
    """
    Örnek videolarla test et
    """
    test_videos = [
        ("https://www.youtube.com/watch?v=dQw4w9WgXcQ", "Rick Astley - Never Gonna Give You Up"),
        ("https://www.youtube.com/watch?v=kJQP7kiw5Fk", "Luis Fonsi - Despacito"),
        ("https://www.youtube.com/watch?v=fJ9rUzIMcZQ", "Queen - Bohemian Rhapsody"),
        ("https://www.youtube.com/watch?v=9bZkp7q19f0", "PSY - Gangnam Style")
    ]
    
    print("🔄 Test videoları ile deneniyor...")
    
    for i, (url, title) in enumerate(test_videos, 1):
        print(f"\n📹 Test Video {i}: {title}")
        print(f"🔗 URL: {url}")
        
        result = generate_transcript_with_time(url, show_preview=False)
        
        if result:
            print(f"✅ {title} - Başarılı!")
            return result
        else:
            print(f"❌ {title} - Başarısız")
            continue
    
    print("😞 Hiçbir test videosu çalışmadı. Manuel URL deneyin.")
    return None

